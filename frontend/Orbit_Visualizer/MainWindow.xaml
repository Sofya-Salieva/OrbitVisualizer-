<Window x:Class="Orbit_Visualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Orbit_Visualizer"
        mc:Ignorable="d"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="Orbit Visualizer" Height="700" Width="900">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель параметров -->
        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
            <TextBlock Text="Высота (км):" Margin="0,5,0,0"/>
            <TextBox x:Name="AltitudeBox" Text="400" Margin="0,0,0,5"/>

            <TextBlock Text="Наклонение (град):" Margin="0,5,0,0"/>
            <TextBox x:Name="InclinationBox" Text="51,6" Margin="0,0,0,5"/>

            <Button x:Name="CalculateButton" Content="Рассчитать" 
                    Click="CalculateButton_Click" Margin="0,10,0,5" Height="30"/>

            <TextBlock x:Name="StatusBlock" Text="Готов" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 3D-сцена -->
        <hx:HelixViewport3D Grid.Column="1" x:Name="Viewport">
            <!-- Сфера Земли -->
            <hx:SphereVisual3D Center="0,0,0" Radius="1" Fill="Blue"/>
            <!-- Сетка (оси) -->
            <hx:GridLinesVisual3D Width="10" Length="10" MajorDistance="1" 
                                   MinorDistance="0.1" Thickness="0.01"/>
            <!-- Линия орбиты -->
            <hx:LinesVisual3D x:Name="OrbitLine" Color="Red" Thickness="2"/>
        </hx:HelixViewport3D>
    </Grid>
</Window>